{
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "android/**",
    "build/**",
    "node_modules/**",
    "public/**"
  ]
}
